{
  "mode": "Microsoft.Kubernetes.Data",
  "parameters": {
    "effect": {
      "type": "String",
      "allowedValues": [
        "audit",
        "deny",
        "disabled"
      ],
      "defaultValue": "deny"
    },
    "namespaces": {
      "type": "Array",
      "defaultValue": []
    },
    "excludedNamespaces": {
      "type": "Array",
      "defaultValue": [
        "kube-system",
        "gatekeeper-system",
        "azure-arc"
      ]
    },
    "suffix": {
      "type": "String"
    }
  },
  "policyRule": {
    "if": {
      "field": "type",
      "in": [
        "Microsoft.ContainerService/managedClusters"
      ]
    },
    "then": {
      "effect": "[parameters('effect')]",
      "details": {
        "templateInfo": {
          "sourceType": "Base64Encoded",
          "content": ""
        },
        "apiGroups": [
          "gateway.networking.k8s.io"
        ],
        "kinds": [
          "ListenerSet",
          "HTTPRoute"
        ],
        "namespaces": "[parameters('namespaces')]",
        "excludedNamespaces": "[parameters('excludedNamespaces')]",
        "values": {
          "suffix": "[parameters('suffix')]"
        }
      }
    }
  }
}